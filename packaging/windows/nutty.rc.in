// Configured by cmake/Packaging.cmake: version info, icon and manifest.

#include <winver.h>

@NUTTY_RC_ICON@

1 24 "@NUTTY_RC_MANIFEST@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "@NUTTY_ORGANIZATION@"
            VALUE "FileDescription", "nutty - UPS and battery monitor"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "nutty"
            VALUE "LegalCopyright", "@NUTTY_COPYRIGHT@"
            VALUE "OriginalFilename", "nutty.exe"
            VALUE "ProductName", "nutty"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
